# Copia a .env y ajusta. Documentado en plan.md §5.8.

# Puerto del host que verá el Cloudflare Tunnel. Elige uno libre en el VPS (ss -ltn).
APP_PORT=8787
# Interfaz del host. Cambia solo si cloudflared corre en contenedor.
APP_BIND=127.0.0.1

# Contraseña compartida. Vacío = sin autenticación (solo para desarrollo local).
LAB_PASSWORD=
# Firma de la cookie de sesión. Cámbiala en el VPS: openssl rand -hex 32
SECRET_KEY=dev-inseguro-cambiar-en-produccion

# Agente operador (Claude vía Strands). Sin API key el agente queda apagado y solo funciona Demo.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
AGENT_TIMEOUT_S=60

# 1.0 = los 24 s reales. Los tests lo bajan para no esperar.
TIMELINE_SCALE=1.0
